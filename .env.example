# Copy to .env (git-ignored). Only the Gemini key is required to serve.
GEMINI_API_KEY=
# Optional: judge model from a second provider for the evaluation
OPENAI_API_KEY=
# Optional: needed only to publish artifacts to the dataset repo
HF_TOKEN=

# Defaults shown; override if needed
# GEN_MODEL=gemini-3.5-flash
# GEN_BASE_URL=http://127.0.0.1:8001/v1    # for the evaluation only: an OpenAI-compatible server (vLLM) serving GEN_MODEL
# GEN_WORKERS=8                            # concurrent generation calls against such a server
# JUDGE_MODEL=gpt-5-mini
# JUDGE_BASE_URL=http://127.0.0.1:8000/v1   # an OpenAI-compatible server (vLLM) serving JUDGE_MODEL; key can be anything
# JUDGE_WORKERS=8                           # concurrent judge calls against such a server
# HF_DATASET_REPO=abrasive519mars/rag-evals-artifacts
# ARTIFACTS_DIR=data/artifacts   # set this to a folder outside OneDrive or any synced folder: with the eval files it is 5 GB
